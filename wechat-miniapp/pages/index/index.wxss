page {
  background-color: #f5f7fa;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #f5f7fa 100%);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1b5e20;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status-dot.online {
  background-color: #04BE02;
  box-shadow: 0 0 10rpx rgba(4,190,2,0.5);
}

.status-dot.offline {
  background-color: #ff9800;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.status-text {
  font-size: 26rpx;
  color: #666;
}

.sensor-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.sensor-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sensor-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.sensor-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.sensor-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #333;
}

.sensor-unit {
  font-size: 32rpx;
  font-weight: 400;
  color: #999;
}

.sensor-divider {
  width: 2rpx;
  height: 120rpx;
  background: #eee;
}

.control-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toggle-label {
  font-size: 30rpx;
  color: #555;
}

.footer {
  text-align: center;
  margin-top: 60rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #ccc;
}